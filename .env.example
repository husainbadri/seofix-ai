# ========================================================
# SEOFix AI - Environment Configuration Template
# ========================================================

# App Configuration
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --------------------------------------------------------
# 1. Supabase (Database & Authentication)
# --------------------------------------------------------
# Obtain from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key"
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# --------------------------------------------------------
# 2. AI Recommendation Engine (OpenAI SDK)
# --------------------------------------------------------
OPENAI_API_KEY="sk-proj-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"

# --------------------------------------------------------
# 3. Google Cloud Console Integrations (OAuth & APIs)
# --------------------------------------------------------
# Authorized Scopes required:
# - https://www.googleapis.com/auth/webmasters.readonly
# - https://www.googleapis.com/auth/analytics.readonly
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"
GOOGLE_PAGESPEED_API_KEY="AIzaSyD-your-pagespeed-insights-api-key"

# --------------------------------------------------------
# 4. Email Notifications (Resend)
# --------------------------------------------------------
RESEND_API_KEY="re_your_resend_api_key"
ALERT_EMAIL_FROM="alerts@seofix.ai"

# --------------------------------------------------------
# 5. Scheduled Monitoring & Background Crons
# --------------------------------------------------------
CRON_SECRET="your-secure-random-cron-secret-token"
CRAWLER_PORT=7001
CRAWLER_HOST="127.0.0.1"
